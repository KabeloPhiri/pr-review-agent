# Copy to .env for local development: cp .env.example .env

# --- Databricks auth (choose one) ---
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
# DATABRICKS_TOKEN=dapi...

# --- MLflow tracing ---
MLFLOW_EXPERIMENT_ID=
MLFLOW_TRACKING_URI="databricks"
MLFLOW_REGISTRY_URI="databricks-uc"

# --- App configuration overrides (see app/defaults/config.yaml) ---
# Every key in the default config can be overridden with PRREVIEW_<KEY>
# PRREVIEW_MODEL_ENDPOINT=databricks-gpt-5-2
# PRREVIEW_SEVERITY_GATE=error
# PRREVIEW_MAX_SYNC_DIFF_BYTES=200000
LOG_LEVEL=INFO
