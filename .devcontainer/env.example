# =============================================================================
#  .devcontainer/.env  -  THE single keys / environment file for the dev container
# =============================================================================
#  How to use
#    1. Copy this file to .devcontainer/.env   (host-prep.ps1 does this on first build)
#    2. Fill only the keys you need. Blank keys are ignored (never exported as "").
#    3. Every value can be a LITERAL or a 1PASSWORD SECRET REFERENCE:
#         DATABRICKS_TOKEN=dapi123...                          <- literal
#         DATABRICKS_TOKEN=op://Databricks-Dev/dev-ws/token    <- 1Password (op://<vault>/<item>/<field>)
#       Mix freely. Migrate one key at a time. See SECRETS.md for the walkthrough.
#    4. Open a new terminal (or:  source .devcontainer/secrets/load-env.sh) and run  env-check
#
#  Rules
#    - .env is gitignored and Claude Code is denied from reading it (.claude/settings.json).
#    - Quote values that contain spaces or '#':  KEY="some value"
#    - No `export`, no shell expansion - plain KEY=value lines only.
# =============================================================================

# ---- 1Password bootstrap ------------------------------------------------------
# Service-account token that lets `op` resolve the op:// references below without
# an interactive sign-in. Once set, this is the ONLY literal secret this file needs.
# Leave blank to use interactive sign-in instead (op account add / eval $(op signin)).
OP_SERVICE_ACCOUNT_TOKEN=

# ---- Databricks ---------------------------------------------------------------
# Prefer profiles in ~/.databrickscfg (mounted from the host) + DATABRICKS_CONFIG_PROFILE.
# HOST/TOKEN here override the profile for the Databricks CLI, SDK and Databricks Connect.
DATABRICKS_CONFIG_PROFILE=dev
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Cluster used by Databricks Connect / VS Code extension (dev only - never uat/prod)
DATABRICKS_CLUSTER_ID=

# ---- AI CLIs ------------------------------------------------------------------
# Leave blank to use OAuth login inside the container (`claude` / `gemini`).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Azure / Azure DevOps -----------------------------------------------------
# `az login` state is mounted from ~/.azure. Set these for az devops defaults + PAT auth.
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_EXT_PAT=

# ---- AWS ----------------------------------------------------------------------
# Profiles/SSO live in ~/.aws (mounted). Pick the default profile for this container.
AWS_PROFILE=
AWS_REGION=

# ---- GCP ----------------------------------------------------------------------
CLOUDSDK_CORE_PROJECT=

# ---- GitHub / GitLab ----------------------------------------------------------
# Leave blank to use `gh auth login` / `glab auth login` (state mounted from host).
GH_TOKEN=
GITLAB_TOKEN=
GITLAB_HOST=

# ---- Bitbucket (used by .devcontainer/bin/bb) ---------------------------------
BITBUCKET_WORKSPACE=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# ---- Terraform ----------------------------------------------------------------
# Terraform Cloud/Enterprise token if remote state is used.
TF_TOKEN_app_terraform_io=
