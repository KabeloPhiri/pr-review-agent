{
  "name": "databricks-toolbox",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",

  // Every version is pinned. Bump deliberately, in its own branch, with a passing CI run.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/powershell:1": { "version": "7.6.6" },
    "ghcr.io/devcontainers/features/azure-cli:1": { "version": "2.90.0" },
    "ghcr.io/devcontainers/features/aws-cli:1": { "version": "2.36.50" },
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "2.101.0" },
    "ghcr.io/devcontainers/features/terraform:1": { "version": "1.16.3" }
  },

  // Secrets and env vars come from ONE file - .devcontainer/.env - read inside the
  // container by secrets/load-env.sh (supports literal values and 1Password op:// refs).
  // Nothing is passed via --env-file or remoteEnv, so the file can be edited and
  // re-sourced without a rebuild. See SECRETS.md.
  "containerEnv": {
    "DATABRICKS_CONFIG_FILE": "/home/vscode/.databrickscfg",
    "AWS_CONFIG_FILE": "/home/vscode/.aws/config",
    "AWS_SHARED_CREDENTIALS_FILE": "/home/vscode/.aws/credentials",
    "CLOUDSDK_CONFIG": "/home/vscode/.config/gcloud",
    "DEVCONTAINER_ENV_FILE": "${containerWorkspaceFolder}/.devcontainer/.env"
  },
  // ${containerEnv:...} is only substituted in remoteEnv (terminals, tasks, exec).
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.devcontainer/bin:${containerEnv:PATH}"
  },

  // Host logins are reused via bind mounts. ${localEnv:HOME}${localEnv:USERPROFILE}
  // resolves to the home dir on Windows and on mac/linux (one of the two is empty).
  // host-prep.ps1 creates any of these that are missing so Docker never turns a
  // missing file into a directory.
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.databrickscfg,target=/home/vscode/.databrickscfg,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.aws,target=/home/vscode/.aws,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.azure,target=/home/vscode/.azure,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh,target=/home/vscode/.config/gh,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/glab-cli,target=/home/vscode/.config/glab-cli,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gcloud,target=/home/vscode/.config/gcloud,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/op,target=/home/vscode/.config/op,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gemini,target=/home/vscode/.gemini,type=bind"
  ],

  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "JupyterLab", "onAutoForward": "notify" }
  },

  "initializeCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File .devcontainer/host-prep.ps1",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "databricks.databricks",
        "databricks.sqltools-databricks-driver",
        "ms-vscode.powershell",
        "ms-vscode.azurecli",
        "amazonwebservices.aws-toolkit-vscode",
        "googlecloudtools.cloudcode",
        "hashicorp.terraform",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "gitlab.gitlab-workflow",
        "redhat.vscode-yaml",
        "anthropic.claude-code",
        "google.geminicodeassist"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "yaml.schemas": {
          "https://raw.githubusercontent.com/databricks/cli/main/bundle/schema/jsonschema.json": [
            "databricks.yml",
            "resources/*.yml"
          ]
        }
      }
    }
  }
}
